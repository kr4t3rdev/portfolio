---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import AnimatedIcon from "../components/icons/AnimatedIcon.astro";
import BrandIcon from "../components/icons/BrandIcon.astro";
import ScrollTextReveal from "../components/animations/ScrollTextReveal.astro";
import ConsoleAssembly from "../components/animations/ConsoleAssembly.astro";
import ScrollImageMotion from "../components/animations/ScrollImageMotion.astro";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#e7e1d4" />
    <meta
      name="description"
      content="Portfolio de Michel García Aguero, ingeniero de software especializado en productos financieros, inventario, aplicaciones móviles y comercio electrónico."
    />
    <script is:inline>
      (() => {
        let stored;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          /* Use the system preference when storage is unavailable. */
        }
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#191b17' : '#e7e1d4');
      })();
    </script>
    <meta property="og:title" content="Michel García Aguero — Software Engineer" />
    <meta
      property="og:description"
      content="Arquitectura sólida. Productos reales. Software preparado para crecer."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kr4t3rdev.xyz" />
    <link rel="canonical" href="https://kr4t3rdev.xyz" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/motion.css" />
    <link rel="stylesheet" href="/theme.css" />
    <script src="/script.js" defer></script>
    <title>Michel García Aguero — Software Engineer</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <div class="scroll-progress" aria-hidden="true"><i></i></div>
    <div class="ambient-grid" data-intro="fade" aria-hidden="true"></div>
    <div class="noise" aria-hidden="true"></div>

    <header class="site-header" data-intro="down">
      <a class="brand" href="#inicio" aria-label="Ir al inicio">
        <span class="brand-mark" aria-hidden="true">M</span>
        <span>MICHEL<span class="brand-dot">.DEV</span></span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="#inicio">Inicio</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#servicios">Servicios</a>
        <a href="#metodo">Método</a>
        <a class="nav-cta" href="#contacto">Contacto <AnimatedIcon name="arrow-up-right" /></a>
        <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Cambiar a modo oscuro">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M4.9 4.9l1.9 1.9M17.2 17.2l1.9 1.9M19.1 4.9l-1.9 1.9M6.8 17.2l-1.9 1.9" />
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20.4 14.2A8.3 8.3 0 0 1 9.8 3.6a8.3 8.3 0 1 0 10.6 10.6Z" />
          </svg>
        </button>
      </nav>
    </header>

    <main id="contenido">
      <section class="hero section-shell" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow" data-intro style="--intro-delay: 90ms"><span class="status-dot"></span> Disponible para proyectos ambiciosos</p>
          <h1 id="hero-title" data-intro="mask" style="--intro-delay: 210ms">
            Diseño sistemas.<br />
            <span class="muted-title">Resuelvo el caos.</span>
          </h1>
          <p class="hero-intro text-pretty" data-intro style="--intro-delay: 360ms">
            Soy <strong>Michel García Aguero</strong>, ingeniero de software. Convierto procesos
            complejos en productos claros, sólidos y preparados para crecer.
          </p>
          <div class="hero-actions" data-intro style="--intro-delay: 480ms">
            <a class="button button-primary" href="#proyectos">
              Explorar proyectos <AnimatedIcon name="arrow-down" />
            </a>
            <a
              class="button button-ghost"
              href="https://github.com/kr4t3rdev"
              target="_blank"
              rel="noreferrer"
            >
              GitHub <AnimatedIcon name="arrow-up-right" />
            </a>
          </div>
        </div>

        <ConsoleAssembly label="Perfil técnico resumido">
        <div class="hero-console">
          <div class="console-bar">
            <span class="console-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>michel.profile</span>
            <span>01</span>
          </div>
          <ScrollTextReveal afterEntrance>
          <div class="console-body">
            <p><span class="prompt">$</span> whoami</p>
            <p class="console-output">software_engineer</p>
            <p><span class="prompt">$</span> cat focus.txt</p>
            <ul class="console-output focus-list">
              <li><span>01</span> Fintech &amp; accounting</li>
              <li><span>02</span> Inventory systems</li>
              <li><span>03</span> Mobile products</li>
              <li><span>04</span> Full-stack commerce</li>
            </ul>
            <p><span class="prompt">$</span> system-status</p>
            <p class="console-output success">● ALL SYSTEMS CURIOUS</p>
          </div>
          </ScrollTextReveal>
        </div>
          <div slot="badge" class="orbit-stamp" aria-hidden="true">
            <span>ARCHITECTURE · CODE · PRODUCT ·</span>
            <strong>MG</strong>
          </div>
        </ConsoleAssembly>
      </section>

      <section class="projects section-shell" id="proyectos" aria-labelledby="projects-title">
        <div class="section-heading reveal" data-motion="mask">
          <div>
            <p class="kicker">TRABAJO SELECCIONADO / 2024—2026</p>
            <h2 id="projects-title">Productos reales,<br />problemas difíciles.</h2>
          </div>
          <p class="section-note">
            Tres proyectos: gestión empresarial, finanzas y comercio electrónico.
          </p>
        </div>

        <div class="project-grid">
          <article class="project-card reveal">
            <div class="project-preview-frame">
              <div class="project-image">
              <ScrollImageMotion><img src="/proyectos/financemdm/preview.webp" alt="Captura de la web de FinanceMDM" width="1440" height="900" loading="lazy" decoding="async" /></ScrollImageMotion>
              </div>
            </div>
            <div class="project-content">
              <div class="project-meta"><span>01</span><span>Web + API + App</span></div>
              <h3>FinanceMDM</h3>
              <p>ERP multiempresa para inventario, compras, ventas y producción, con facturación multidivisa y trazabilidad por roles. Web y API; apps nativas para iOS y Android en desarrollo.</p>
              <ul class="tech-list" data-stagger aria-label="Stack de FinanceMDM">
                <li>Next.js</li><li>TypeScript</li><li>Prisma</li><li>PostgreSQL</li><li>Swift</li><li>Kotlin</li><li>OpenAPI</li>
              </ul>
              <div class="project-actions" aria-label="Enlaces de FinanceMDM">
                <span class="project-link project-link-unavailable" aria-disabled="true" title="Repositorio privado">Repo<span class="project-action-status">Privado</span></span>
                <a class="project-link" href="/proyectos/financemdm/">Caso de Estudio <AnimatedIcon name="arrow-up-right" /></a>
                <a class="project-link" href="https://financemdm.kr4t3rdev.xyz" target="_blank" rel="noreferrer">Preview <AnimatedIcon name="arrow-up-right" /></a>
              </div>
            </div>
          </article>
          <article class="project-card reveal">
            <div class="project-preview-frame">
              <div class="project-image">
              <ScrollImageMotion><img src="/proyectos/cashflows/preview.webp" alt="Captura de la web de Cashflows" width="1440" height="900" loading="lazy" decoding="async" /></ScrollImageMotion>
              </div>
            </div>
            <div class="project-content">
              <div class="project-meta"><span>02</span><span>Web + API + App</span></div>
              <h3>Cashflows</h3>
              <p>Web y API para casas de cambio: saldos y movimientos por moneda, tasas, gastos, conciliaciones y reportes de flujo de caja. Apps nativas en desarrollo.</p>
              <ul class="tech-list" data-stagger aria-label="Stack de Cashflows">
                <li>NestJS</li><li>TypeScript</li><li>Prisma</li><li>PostgreSQL</li><li>Swift</li><li>Kotlin</li><li>OpenAPI</li>
              </ul>
              <div class="project-actions" aria-label="Enlaces de Cashflows">
                <span class="project-link project-link-unavailable" aria-disabled="true" title="Código fuente no disponible públicamente">Repo<span class="project-action-status">No público</span></span>
                <a class="project-link" href="/proyectos/cashflows/">Caso de Estudio <AnimatedIcon name="arrow-up-right" /></a>
                <a class="project-link" href="https://cashflow.kr4t3rdev.xyz" target="_blank" rel="noreferrer">Preview <AnimatedIcon name="arrow-up-right" /></a>
              </div>
            </div>
          </article>
          <article class="project-card reveal">
            <div class="project-preview-frame">
              <div class="project-image">
              <ScrollImageMotion><img src="/proyectos/yoisel-shop/preview.webp" alt="Captura de la web de Yoisel Shop" width="1440" height="900" loading="lazy" decoding="async" /></ScrollImageMotion>
              </div>
            </div>
            <div class="project-content">
              <div class="project-meta"><span>03</span><span>Web + API · E-commerce</span></div>
              <h3>Yoisel Shop</h3>
              <p>Tienda online con catálogo, combos, ofertas y checkout; incluye panel para inventario, pedidos, ventas y usuarios. Web en Next.js, API en Go.</p>
              <ul class="tech-list" data-stagger aria-label="Stack de Yoisel Shop">
                <li>Next.js</li><li>TypeScript</li><li>Go</li><li>PostgreSQL</li><li>Tailwind CSS</li>
              </ul>
              <div class="project-actions" aria-label="Enlaces de Yoisel Shop">
                <span class="project-link project-link-unavailable" aria-disabled="true" title="Repositorio privado">Repo<span class="project-action-status">Privado</span></span>
                <a class="project-link" href="/proyectos/yoisel-shop/">Caso de Estudio <AnimatedIcon name="arrow-up-right" /></a>
                <a class="project-link" href="https://yoisel-shop.vercel.app" target="_blank" rel="noreferrer">Preview <AnimatedIcon name="arrow-up-right" /></a>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="services section-shell" id="servicios" aria-labelledby="services-title">
        <header class="section-heading services-heading reveal" data-motion="mask">
          <h2 id="services-title">Diseño que se entiende.<br />Ingeniería que responde.</h2>
          <p class="section-note">Servicios por alcance, no paquetes rígidos. Cada propuesta parte de tus objetivos, procesos y prioridades.</p>
        </header>
        <div class="service-catalog" aria-label="Servicios de desarrollo">
          <article class="service-card reveal" data-motion="left" aria-labelledby="service-landing">
            <a class="service-photo" href="/servicios/landing" aria-label="Ver detalles de diseño web y presencia"><img src="/images/services/landing.webp" alt="Espacio de trabajo de un pequeño negocio, preparado para atender clientes" width="960" height="640" loading="lazy" decoding="async" /></a>
            <div class="service-card-copy"><p class="service-tag"><AnimatedIcon name="layout-panel-top" />WEB / PRESENCIA</p><h3 id="service-landing">Una primera impresión que trabaja por tu marca.</h3><p>Landing pages y sitios claros que presentan tu propuesta, productos y próximos pasos.</p><a class="service-cta" href="/servicios/landing">Ver detalles <AnimatedIcon name="arrow-up-right" /></a></div>
          </article>
          <article class="service-card reveal" data-motion="right" aria-labelledby="service-negocio">
            <a class="service-photo" href="/servicios/negocio" aria-label="Ver detalles de sistemas para pequeños negocios"><img src="/images/services/business.webp" alt="Comerciante gestionando una venta en el mostrador de su negocio" width="960" height="640" loading="lazy" decoding="async" /></a>
            <div class="service-card-copy"><p class="service-tag"><AnimatedIcon name="server" />WEB / OPERACIÓN</p><h3 id="service-negocio">Menos tareas dispersas. Más control del negocio.</h3><p>Aplicaciones web con API y base de datos para ordenar los procesos cotidianos.</p><a class="service-cta" href="/servicios/negocio">Ver detalles <AnimatedIcon name="arrow-up-right" /></a></div>
          </article>
          <article class="service-card reveal" data-motion="zoom" aria-labelledby="service-plataforma">
            <a class="service-photo" href="/servicios/plataforma" aria-label="Ver detalles de plataformas web y móviles"><img src="/images/services/platform.webp" alt="Equipo de trabajo coordinando un proyecto en una mesa" width="960" height="640" loading="lazy" decoding="async" /></a>
            <div class="service-card-copy"><p class="service-tag"><AnimatedIcon name="layers" />PLATAFORMA / WEB + MÓVIL</p><h3 id="service-plataforma">Una plataforma para usuarios, equipos y operaciones complejas.</h3><p>Servicios compartidos, controles de acceso y aplicaciones nativas según el alcance.</p><a class="service-cta" href="/servicios/plataforma">Ver detalles <AnimatedIcon name="arrow-up-right" /></a></div>
          </article>
        </div>
      </section>
      <section class="method section-shell" id="metodo" aria-labelledby="method-title">
        <div class="method-intro reveal">
          <p class="kicker">MI MANERA DE CONSTRUIR</p>
          <h2 id="method-title">Menos magia.<br />Más ingeniería.</h2>
          <p class="method-manifesto">No construyo pantallas aisladas. Construyo <em>sistemas completos</em>: desde la regla de negocio y el contrato de datos hasta la experiencia que finalmente toca el usuario.</p>
          <p>
            La velocidad importa, pero nunca a costa de los fundamentos. Cada producto empieza por
            comprender el negocio y termina con evidencia de que realmente funciona.
          </p>
        </div>
        <ol class="method-list" data-stagger>
          <li>
            <span>01 / ENTENDER</span>
            <div><h3>Primero el problema</h3><p>Modelo el dominio, los riesgos y las reglas antes de elegir herramientas.</p></div>
          </li>
          <li>
            <span>02 / DISEÑAR</span>
            <div><h3>Arquitectura con intención</h3><p>Separo responsabilidades para que el sistema pueda cambiar sin colapsar.</p></div>
          </li>
          <li>
            <span>03 / PROBAR</span>
            <div><h3>Evidencia, no esperanza</h3><p>Las pruebas, contratos y observabilidad convierten suposiciones en confianza.</p></div>
          </li>
          <li>
            <span>04 / ENTREGAR</span>
            <div><h3>Producto completo</h3><p>Una interfaz clara y un despliegue estable son parte de la ingeniería.</p></div>
          </li>
        </ol>
      </section>

      <section class="contact section-shell reveal" id="contacto" aria-labelledby="contact-title">
        <div class="contact-code" data-parallax="0.05" aria-hidden="true">READY<br />FOR WHAT'S NEXT</div>
        <div class="contact-copy">
          <p class="kicker">CANAL ABIERTO</p>
          <h2 id="contact-title">¿Construimos algo que importe?</h2>
          <p>
            Si tienes un producto complejo, una operación que necesita orden o una idea que merece
            bases sólidas, conversemos.
          </p>
          <div class="social-links" data-stagger="pop" aria-label="Redes sociales y contacto">
            <a
              class="social-link social-link-whatsapp"
              href="https://wa.me/5353917705"
              target="_blank"
              rel="noreferrer"
              aria-label="Contactar por WhatsApp"
              title="WhatsApp"
            >
              <BrandIcon name="whatsapp" />
            </a>
            <a
              class="social-link social-link-instagram"
              href="https://www.instagram.com/kr4t3rdev/"
              target="_blank"
              rel="noreferrer"
              aria-label="Ver Instagram de Michel"
              title="Instagram"
            >
              <BrandIcon name="instagram" />
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer section-shell reveal">
      <p>© <span id="year">2026</span> Michel García Aguero</p>
      <p>Diseñado con intención. Construido con código.</p>
      <a href="#inicio">Volver arriba <AnimatedIcon name="arrow-up" /></a>
    </footer>
  </body>
</html>
