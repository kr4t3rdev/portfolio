---
interface Props {
  /** Fraction of a viewport over which the reveal unfolds. */
  distance?: number;
  /** Minimum opacity of words before they are revealed. */
  minOpacity?: number;
  /** Animate words after a parent ConsoleAssembly finishes integrating. */
  afterEntrance?: boolean;
}
const { distance = 0.8, minOpacity = 0.65, afterEntrance = false } = Astro.props;
const safeDistance = Math.min(2, Math.max(0.25, Number.isFinite(distance) ? distance : 0.8));
const safeOpacity = Math.min(1, Math.max(0.6, Number.isFinite(minOpacity) ? minOpacity : 0.65));
---
<div data-scroll-text-reveal data-reveal-distance={safeDistance} data-reveal-min-opacity={safeOpacity} data-after-entrance={afterEntrance ? "true" : undefined}>
  <slot />
</div>

<script>
  let cleanup = () => {};
  let initialized = false;

  function initScrollTextReveal() {
    if (initialized) return;
    cleanup();
    const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-scroll-text-reveal]'));
    if (!roots.length) return;
    initialized = true;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const instances = roots.map((root) => {
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          return node.textContent?.trim() && node.parentElement?.closest('script, style, [aria-hidden="true"]') === null
            ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
        },
      });
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      const words: HTMLElement[] = [];
      for (const node of nodes) {
        const fragment = document.createDocumentFragment();
        for (const part of (node.textContent ?? '').split(/(\s+)/)) {
          if (!part) continue;
          if (/^\s+$/.test(part)) fragment.append(document.createTextNode(part));
          else {
            const word = document.createElement('span');
            word.dataset.scrollRevealWord = '';
            word.style.display = 'inline';
            word.style.width = 'auto';
            word.style.color = 'inherit';
            word.textContent = part;
            words.push(word);
            fragment.append(word);
          }
        }
        node.replaceWith(fragment);
      }
      return { root, words, distance: Number(root.dataset.revealDistance), min: Number(root.dataset.revealMinOpacity) };
    });
    let frame = 0;
    const entranceAnimations: Animation[] = [];
    const awaiting = new Set(instances.filter(({ root }) => root.dataset.afterEntrance && root.closest('[data-console-assembly]')));
    function onIntegrated(event: Event) {
      if (reduced.matches) return;
      for (const instance of awaiting) {
        if (!instance.root.closest('[data-console-assembly]')?.contains(event.target as Node)) continue;
        awaiting.delete(instance);
        instance.words.forEach((word, index) => {
          word.style.opacity = '1';
          entranceAnimations.push(word.animate([{ opacity: instance.min }, { opacity: 1 }], {
            duration: 320, delay: Math.min(index * 30, 720), fill: 'backwards', easing: 'ease-out'
          }));
        });
      }
    }
    function onScroll() {
      entranceAnimations.splice(0).forEach(animation => animation.cancel());
      schedule();
    }
    document.addEventListener('assembly:integrated', onIntegrated);
    function update() {
      frame = 0;
      for (const { root, words, distance, min } of instances) {
        const rect = root.getBoundingClientRect();
        const range = Math.max(1, window.innerHeight * distance);
        const progress = Math.max(0, Math.min(1, (window.innerHeight * 0.9 - rect.top) / (range + rect.height * 0.5)));
        words.forEach((word, index) => {
          const wordProgress = Math.max(0, Math.min(1, progress * (words.length + 4) - index));
          word.style.opacity = reduced.matches ? '' : String(min + (1 - min) * wordProgress);
        });
      }
    }
    function schedule() { if (!frame) frame = window.requestAnimationFrame(update); }
    function onReducedChange() {
      if (reduced.matches) {
        awaiting.clear();
        entranceAnimations.splice(0).forEach(animation => animation.cancel());
      }
      schedule();
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', schedule);
    reduced.addEventListener('change', onReducedChange);
    update();
    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('assembly:integrated', onIntegrated);
      entranceAnimations.forEach(animation => animation.cancel());
      window.removeEventListener('resize', schedule);
      reduced.removeEventListener('change', onReducedChange);
      if (frame) window.cancelAnimationFrame(frame);
      for (const { root, words } of instances) {
        for (const word of words) word.replaceWith(document.createTextNode(word.textContent ?? ''));
        root.normalize();
      }
      initialized = false;
      cleanup = () => {};
    };
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initScrollTextReveal, { once: true });
  else initScrollTextReveal();
  document.addEventListener('astro:page-load', initScrollTextReveal);
  document.addEventListener('astro:before-swap', () => cleanup());
</script>
