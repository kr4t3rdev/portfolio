---
interface Props {
  /** Image scale at the beginning of the viewport traversal. */
  startScale?: number;
  /** Image scale at the end of the viewport traversal. */
  endScale?: number;
  /** Maximum vertical travel as a fraction of the frame height. */
  travel?: number;
}
const { startScale = 1.04, endScale = 1.18, travel = 0.04 } = Astro.props;
const clamp = (value: number, fallback: number) => Number.isFinite(value) ? Math.min(1.35, Math.max(1, value)) : fallback;
---
<div class="scroll-image-motion" data-scroll-image-motion data-start-scale={clamp(startScale, 1.04)} data-end-scale={clamp(endScale, 1.18)} data-travel={Number.isFinite(travel) ? Math.min(0.15, Math.max(0, travel)) : 0.04}>
  <slot />
</div>

<style>
  .scroll-image-motion { width: 100%; height: 100%; overflow: hidden; }
  .scroll-image-motion :global(img) { transform-origin: center center; }
  @media (prefers-reduced-motion: reduce) {
    .scroll-image-motion :global(img) { transform: none !important; }
  }
</style>

<script>
  import { getImageMotion } from "./scroll-image-motion.mjs";
  let initialized = false;
  let cleanup = () => {};

  function initScrollImageMotion() {
    if (initialized) return;
    const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-scroll-image-motion]'));
    if (!roots.length) return;
    initialized = true;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const instances = roots.map(root => ({
      root,
      image: root.querySelector<HTMLImageElement>('img'),
      start: Number(root.dataset.startScale),
      end: Number(root.dataset.endScale),
      travel: Number(root.dataset.travel),
    })).filter((item): item is typeof item & { image: HTMLImageElement } => item.image !== null);
    let frame = 0;
    function update() {
      frame = 0;
      for (const { root, image, start, end, travel } of instances) {
        if (reduced.matches) { image.style.removeProperty('transform'); continue; }
        const rect = root.getBoundingClientRect();
        const progress = Math.max(0, Math.min(1, (window.innerHeight - rect.top) / (window.innerHeight + rect.height)));
        const { scale, offset } = getImageMotion(start, end, travel, progress, rect.height);
        image.style.transform = `translateY(${offset}px) scale(${scale})`;
      }
    }
    function schedule() { if (!frame) frame = window.requestAnimationFrame(update); }
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    reduced.addEventListener('change', schedule);
    update();
    cleanup = () => {
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      reduced.removeEventListener('change', schedule);
      if (frame) window.cancelAnimationFrame(frame);
      for (const { image } of instances) image.style.removeProperty('transform');
      initialized = false;
      cleanup = () => {};
    };
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initScrollImageMotion, { once: true });
  else initScrollImageMotion();
  document.addEventListener('astro:page-load', initScrollImageMotion);
  document.addEventListener('astro:before-swap', () => cleanup());
</script>
